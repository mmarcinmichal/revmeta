@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix revmeta: <https://w3id.org/revmeta/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

revmeta:TermShape a sh:NodeShape ;
  sh:targetClass skos:Concept ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:uniqueLang true ] ;
  sh:property [ sh:path skos:definition ; sh:minCount 1 ; sh:maxCount 1 ; sh:uniqueLang true ] ;
  sh:property [ sh:path skos:inScheme ; sh:hasValue revmeta:scheme ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path revmeta:annotationDepth ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "CORE_FACET" "OPTIONAL_DETAIL" "REVIEW" ) ] ;
  sh:property [ sh:path revmeta:codeWhen ; sh:minCount 1 ; sh:class revmeta:CodingGuidanceItem ] ;
  sh:property [ sh:path revmeta:doNotCodeWhen ; sh:minCount 1 ; sh:class revmeta:CodingGuidanceItem ] ;
  sh:property [ sh:path revmeta:boundaryNote ; sh:minCount 1 ; sh:class revmeta:CodingGuidanceItem ] ;
  sh:property [ sh:path revmeta:positiveExample ; sh:minCount 1 ; sh:class revmeta:CodingGuidanceItem ] ;
  sh:property [ sh:path revmeta:negativeExample ; sh:minCount 1 ; sh:class revmeta:CodingGuidanceItem ] .

revmeta:FacetShape a sh:NodeShape ;
  sh:targetClass skos:Collection ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:definition ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:scopeNote ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:member ; sh:minCount 1 ; sh:class skos:Concept ] .

revmeta:CodingRuleShape a sh:NodeShape ;
  sh:targetClass revmeta:CodingGuidanceItem ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
  sh:property [ sh:path revmeta:itemIndex ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path revmeta:sourceLine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .
