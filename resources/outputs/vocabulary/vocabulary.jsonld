  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematicReviewDesign/boundaryNote/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "For SystematicReviewDesign, self-label is necessary/strong framing evidence but is not sufficient without compatible minimum process realization: structured search/retrieval + explicit selection/screening."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 118
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematicReviewDesign/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The publication frames the review itself as a systematic review (or equivalent review-level systematic design) AND documents a structured/reproducible search or retrieval process AND explicit screening/selection/eligibility decisions for a bounded evidence set."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 109
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematicReviewDesign/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not code from the self-label “systematic review” alone when compatible structured search/retrieval and explicit selection/screening are not documented."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 112
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematicReviewDesign/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer from systematic searching/retrieval alone when the paper does not frame the review/survey itself as systematic."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 113
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematicReviewDesign/doNotCodeWhen/003",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not require quality appraisal as a universal condition for SystematicReviewDesign."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 114
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematicReviewDesign/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The paper calls itself a systematic review but does not document a structured search/retrieval procedure and explicit screening/selection."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
