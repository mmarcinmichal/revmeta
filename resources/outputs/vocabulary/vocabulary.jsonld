      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 953
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasAnalyticalObjectType.ResearchMethod/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not code the current review’s own synthesis method here; use usesSynthesisMethod."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
