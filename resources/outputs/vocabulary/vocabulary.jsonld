    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A multivocal literature review is not automatically a systematic mapping design."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
