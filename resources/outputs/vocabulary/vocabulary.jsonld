    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The protocol says that blog post sources were eligible, but the final corpus does not demonstrate that any were included."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
