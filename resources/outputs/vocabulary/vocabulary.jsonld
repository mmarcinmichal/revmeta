    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The current review proposes a bounded engineered/design solution such as a method, architecture, reference design or iterative system process with identifiable components/relations."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
