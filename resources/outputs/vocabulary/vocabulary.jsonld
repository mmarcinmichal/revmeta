    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A review-authored “promising method” with specified components and feedback cycle can qualify even if conceptual rather than implemented."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
