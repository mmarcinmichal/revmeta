    "@id": "https://w3id.org/revmeta/guidance/hasAnalyticalObjectType.ResearchMethod/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Research/evaluation/investigation methods themselves are compared, categorized, appraised, or synthesized across sources."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
