  {
    "@id": "https://w3id.org/revmeta/codeWhen",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a RevMeta term to ordered Codebook guidance items in this exact category; not an OWL inference rule."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "CODE WHEN"
      }
    ]
  },
