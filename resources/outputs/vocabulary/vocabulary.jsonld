    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The authors explicitly state that the review was conducted as a systematic mapping design, and the methods are compatible with that declared design."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
