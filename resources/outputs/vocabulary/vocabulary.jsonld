  {
    "@id": "https://w3id.org/revmeta/hasReviewDesign.SystematicReviewDesign",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A review design in which the publication frames the review itself as systematic and realizes that framing through an explicit, structured/reproducible evidence search or retrieval process plus explicit screening/selection/eligibility decisions for a bounded evidence set."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/revmeta/scheme"
      }
