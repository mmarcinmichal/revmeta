    "@id": "https://w3id.org/revmeta/guidance/hasAgentConfiguration.HybridHumanMachine/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not collapse clearly separate human-only and automation-only stages into a hybrid assertion."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
