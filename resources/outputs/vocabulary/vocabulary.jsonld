  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasSourceDocumentType.WhitePaper/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The final included-corpus table or text demonstrates at least one included white paper."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 694
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasUpdateMode.LivingUpdateMode/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A one-off updated review is not living; ongoing update commitment is required."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1738
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasUpdateMode.LivingUpdateMode/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The source explicitly identifies the review as living or specifies an ongoing update mechanism."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1731
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasUpdateMode.LivingUpdateMode/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A one-off update of an earlier review is insufficient."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1734
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasUpdateMode.LivingUpdateMode/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A rerunnable repository alone does not imply living mode."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1735
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasUpdateMode.LivingUpdateMode/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The publication is a one-time update of an older review with no ongoing update commitment."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1744
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasUpdateMode.LivingUpdateMode/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The authors state that the review is living and will be updated as new evidence appears."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1741
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A benchmark discussed or compared is not a produced benchmark artifact."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2221
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 1 — production: the artifact is generated by the current review rather than merely analyzed from prior literature."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2211
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/codeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 2 — discrete identity: the output passes the DISCRETE_ARTIFACT test and can be identified as a bounded scholarly product even if embedded in the article."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2212
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/codeWhen/003",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 3 — type fit: The product is a reusable benchmark, evaluation suite, benchmarking protocol, or reference resource intended to standardize comparative evaluation."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2213
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Ordinary result tables, figures, lists, analysis steps, generic recommendations, or supplementary files without independent scholarly-product identity are insufficient."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2216
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer a claimsContributionType value automatically from artifact presence."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2217
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/doNotCodeWhen/003",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not multi-type the same product unless it independently satisfies every asserted artifact definition."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2218
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "An ordinary table, figure, or discussion passage resembles a benchmark artifact but has no discrete artifact identity."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2227
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.BenchmarkArtifact/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The review produces a named or otherwise discrete benchmark artifact that can be independently identified and reused/referred to."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2224
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.ConceptualModelArtifact/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A process diagram may qualify when it is a generalized review-produced model; an ordinary flowchart of the review procedure does not."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2177
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.ConceptualModelArtifact/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A review-produced model/process scheme explicitly represents entities/concepts/stages and meaningful relations among them, and the paper treats it as an output/contribution rather than ordinary illustration."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2169
      }
    ]
  },
