      {
        "@value": "REVIEW"
      }
    ],
    "https://w3id.org/revmeta/boundaryNote": [
      {
        "@id": "https://w3id.org/revmeta/guidance/hasOrganizingLens.CrossLayerLens/boundaryNote/001"
      },
      {
        "@id": "https://w3id.org/revmeta/guidance/hasOrganizingLens.CrossLayerLens/boundaryNote/002"
      },
      {
        "@id": "https://w3id.org/revmeta/guidance/hasOrganizingLens.CrossLayerLens/boundaryNote/003"
      }
    ],
    "https://w3id.org/revmeta/codeWhen": [
      {
        "@id": "https://w3id.org/revmeta/guidance/hasOrganizingLens.CrossLayerLens/codeWhen/001"
      },
