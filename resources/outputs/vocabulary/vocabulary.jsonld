    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a RevMeta term to ordered Codebook guidance items in this exact category; not an OWL inference rule."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "DO NOT CODE WHEN"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/claimsContributionType",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "claimsContributionType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review publication to types of scholarly contribution that the authors explicitly present as principal value added by the work and materially realize."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.ArgumentativeContribution"
      },
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.BenchmarkContribution"
      },
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.ConceptualContribution"
      },
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.DesignArtifactContribution"
      },
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.FrameworkContribution"
      },
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.MethodologicalContribution"
      },
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.ResearchAgendaContribution"
      },
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.ResourceContribution"
      },
      {
        "@id": "https://w3id.org/revmeta/claimsContributionType.TaxonomyContribution"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:claimsContributionType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "claimed contribution type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Claims are about principal value added, not merely what the paper does or contains. Type-fit overrides labels. Publication function and output artifact remain separate."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "OPTIONAL_DETAIL"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasAgentConfiguration",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasAgentConfiguration"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates specified review workflow stages to the human, automated, or integrated human-machine configuration that performs substantive work at those stages."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasAgentConfiguration.AutomatedAgent"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAgentConfiguration.HybridHumanMachine"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAgentConfiguration.MultipleHumanReviewers"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAgentConfiguration.SingleHumanReviewer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasAgentConfiguration"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "agent configuration"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The primary boundary is AutomatedAgent versus HybridHumanMachine, plus coexistence of SingleHumanReviewer and MultipleHumanReviewers within a stage when procedures differ by substage."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "OPTIONAL_DETAIL"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasAnalyticalObjectType",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasAnalyticalObjectType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review to broad categories that themselves function as material analytical dimensions or direct targets of cross-corpus comparison, classification, mapping, appraisal, aggregation, interpretation, or synthesis. Mere evidence-carrier status, routine extraction, evaluation context, or named-instance occurrence is insufficient."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Algorithm"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Architecture"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Benchmark"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.BibliographicMetadata"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.ComputationalModel"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Concept"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Dataset"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.EffectEstimate"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.ExistingReview"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.ExistingSurvey"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Finding"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Framework"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Indicator"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.InterventionOrProgramme"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.MeasurementInstrument"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Mechanism"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Practice"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Repository"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.ResearchMethod"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.ResearchTradition"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.SoftwareTool"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Standard"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Study"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Taxonomy"
      },
      {
        "@id": "https://w3id.org/revmeta/hasAnalyticalObjectType.Theory"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasAnalyticalObjectType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "analytical object type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Multi-label coexistence is allowed only when each neighbor has independent material evidence. Do not co-code broader/adjacent terms merely because one concrete object can be described in several everyday-language ways."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasCorpusComposition",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasCorpusComposition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Classifies the included analyzable evidence corpus by whether it consists of scholarly/academic literature, grey/practice literature, or a substantive combination of both."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasCorpusComposition.AcademicAndGreyLiteratureCorpus"
      },
      {
        "@id": "https://w3id.org/revmeta/hasCorpusComposition.AcademicLiteratureCorpus"
      },
      {
        "@id": "https://w3id.org/revmeta/hasCorpusComposition.GreyLiteratureCorpus"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasCorpusComposition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "corpus composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "AcademicLiteratureCorpus, GreyLiteratureCorpus, and AcademicAndGreyLiteratureCorpus are mutually exclusive."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasEvidenceSourceRole",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasEvidenceSourceRole"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review to semantic roles played by sources that materially contribute analyzable evidence to the included corpus, including primary/secondary/survey/practice-based evidence and methodological-guidance evidence."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasEvidenceSourceRole.ExistingSurvey"
      },
      {
        "@id": "https://w3id.org/revmeta/hasEvidenceSourceRole.MethodologicalGuidanceSource"
      },
      {
        "@id": "https://w3id.org/revmeta/hasEvidenceSourceRole.PracticeBasedSource"
      },
      {
        "@id": "https://w3id.org/revmeta/hasEvidenceSourceRole.PrimaryStudyReport"
      },
      {
        "@id": "https://w3id.org/revmeta/hasEvidenceSourceRole.SecondaryStudyReport"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasEvidenceSourceRole"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "evidence source role"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Source roles may coexist. MethodologicalGuidanceSource is role-based, not a document type: a Guideline/Standard/JournalArticle can bear this role, and a methodological empirical study can additionally be PrimaryStudyReport if both roles are material."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasExecutionMode",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasExecutionMode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review investigation to an explicit accelerated execution mode intended to shorten the review process through a recognized rapid-review approach."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasExecutionMode.RapidExecutionMode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasExecutionMode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "execution mode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Rapid execution can coexist with a separately coded review design."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasOrganizingLens",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasOrganizingLens"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review to an explicit organizing perspective through which relationships among subject-matter levels or layers are synthesized."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasOrganizingLens.CrossLayerLens"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasOrganizingLens"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "organizing lens"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Current singleton vocabulary is domain-sensitive and showed a zero pooled Jaccard in confirmatory evaluation; extension-module treatment is preferable unless revalidated."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "REVIEW"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasPublicationFunction",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasPublicationFunction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates a review publication to a principal communicative or scholarly function that is explicitly cued and materially realized in the publication."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.AgendaSettingFunction"
      },
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.CriticalSynthesisFunction"
      },
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.PerspectiveFunction"
      },
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.PositionFunction"
      },
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.ProtocolFunction"
      },
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.StateOfTheArtFunction"
      },
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.SurveyFunction"
      },
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.TutorialFunction"
      },
      {
        "@id": "https://w3id.org/revmeta/hasPublicationFunction.VisionFunction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasPublicationFunction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "publication function"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The same publication may realize several functions. Distinguish function from design, contribution claim, and output artifact."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasRegistrationStatus",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasRegistrationStatus"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Classifies whether the review is explicitly registered in a formal review registry/comparable registration system or explicitly states that it was not registered."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasRegistrationStatus.ExplicitlyNotRegistered"
      },
      {
        "@id": "https://w3id.org/revmeta/hasRegistrationStatus.Registered"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasRegistrationStatus"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "registration status"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Registration status is optional detail; timing is a qualifier, not an additional status value."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "OPTIONAL_DETAIL"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasReviewDesign",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasReviewDesign"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates a review publication to the methodological review design realized by the reported review investigation, not merely to a synthesis technique, speed modifier, update mode, or publication genre label."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.IntegrativeReviewDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.MetaNarrativeReviewDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.NarrativeReviewDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.QualitativeEvidenceSynthesisDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.RealistReviewDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.ScopingReviewDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.SystematicMappingDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.SystematicReviewDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.SystematizedReviewDesign"
      },
      {
        "@id": "https://w3id.org/revmeta/hasReviewDesign.UmbrellaReviewDesign"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasReviewDesign"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "review design"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Design values are not globally mutually exclusive. SystematicReviewDesign requires conjunction of review-level systematic framing + process realization; label alone and search alone are each insufficient."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasSourceDocumentType",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasSourceDocumentType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review to document or publication types demonstrably present in the included analyzable corpus."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.BlogPost"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.BookOrChapter"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.ConferencePaper"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.Documentation"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.EditorialCommentary"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.Guideline"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.JournalArticle"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.Preprint"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.ProgrammeManual"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.Standard"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.TechnicalReport"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.Thesis"
      },
      {
        "@id": "https://w3id.org/revmeta/hasSourceDocumentType.WhitePaper"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasSourceDocumentType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "source document type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Documentary forms are independent of evidence roles and corpus-composition boundedness. Do not import the stronger bounded-final-corpus threshold from hasCorpusComposition into source-document presence decisions."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "OPTIONAL_DETAIL"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/hasUpdateMode",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasUpdateMode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review investigation to an explicit living/continuous update mode in which the evidence synthesis is intended to be updated as new evidence becomes available."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/hasUpdateMode.LivingUpdateMode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasUpdateMode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "update mode"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Living update mode is orthogonal to review design and publication function."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/producesOutputArtifact",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "producesOutputArtifact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review to discrete, identifiable, reusable or independently referable scholarly artifacts generated as outputs of the review synthesis."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/producesOutputArtifact.BenchmarkArtifact"
      },
      {
        "@id": "https://w3id.org/revmeta/producesOutputArtifact.ConceptualModelArtifact"
      },
      {
        "@id": "https://w3id.org/revmeta/producesOutputArtifact.DesignArtifact"
      },
      {
        "@id": "https://w3id.org/revmeta/producesOutputArtifact.EvidenceMap"
      },
      {
        "@id": "https://w3id.org/revmeta/producesOutputArtifact.FrameworkArtifact"
      },
      {
        "@id": "https://w3id.org/revmeta/producesOutputArtifact.ResearchAgenda"
      },
      {
        "@id": "https://w3id.org/revmeta/producesOutputArtifact.ResearchResource"
      },
      {
        "@id": "https://w3id.org/revmeta/producesOutputArtifact.TaxonomyArtifact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:producesOutputArtifact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "output artifact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Discreteness is functional, not file-based. Type-fit overrides labels; multi-typing requires independent structural fit for each type."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facet/usesSynthesisMethod",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "usesSynthesisMethod"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relates the review to substantive methods used to integrate, aggregate, code, map, interpret, or otherwise synthesize evidence across included sources."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.BibliometricNetworkSynthesis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.DescriptiveMappingSynthesis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.FrameworkSynthesis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.MetaAnalysis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.MetaNarrativeSynthesis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.MixedMethodsSynthesis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.NarrativeSynthesis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.QualitativeContentAnalysis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.QualitativeMetaSynthesis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.RealistSynthesis"
      },
      {
        "@id": "https://w3id.org/revmeta/usesSynthesisMethod.ThematicSynthesis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:usesSynthesisMethod"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "synthesis method"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Explicit label plus substantive realization is sufficient; label alone is not. Nested synthesis methods may coexist. Local framework use, presentation style, and extraction are not independent synthesis methods."
      }
    ],
    "https://w3id.org/revmeta/facetTier": [
      {
        "@value": "CORE_FACET"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/facetTier",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Facet tier copied verbatim from the canonical Codebook."
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Ordinary interpretation or critique is insufficient unless a structured argument/position is claimed as principal contribution."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2079
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/boundaryNote/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "May overlap with PositionFunction but requires an independent contribution claim."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2080
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 1 — principal claim: central text explicitly presents a structured thesis, critique, position, or argument as a principal contribution/value added by the publication."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2069
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/codeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 2 — type fit: the claimed contribution advances and supports a reasoned position/critique derived from the synthesis rather than merely interpreting results."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2070
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/codeWhen/003",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 3 — realization: the claimed contribution is materially developed in the publication rather than merely promised, mentioned, or implied by an artifact."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2071
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer a contribution claim solely from the existence of a corresponding artifact, method, section, or recommendation."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2074
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Generic usefulness, ordinary synthesis, incidental outputs, and routine implications are insufficient."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2075
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/doNotCodeWhen/003",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "If the authors make no principal contribution claim of this type, code 0 even when related content is present."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2076
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A related element appears in the paper, but it is not explicitly claimed as a principal argumentative contribution."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2086
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.ArgumentativeContribution/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The abstract or contribution statement explicitly presents a argumentative contribution as a principal contribution and the paper materially realizes it."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2083
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.BenchmarkContribution/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Distinguish claimed contribution from BenchmarkArtifact output and Benchmark analytical object."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2032
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.BenchmarkContribution/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 1 — principal claim: central text explicitly presents a benchmark, benchmarking protocol, or evaluation suite as a principal contribution/value added by the publication."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2022
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.BenchmarkContribution/codeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 2 — type fit: the claimed contribution creates/substantially develops a standardized comparative-evaluation resource or protocol."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2023
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.BenchmarkContribution/codeWhen/003",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Gate 3 — realization: the claimed contribution is materially developed in the publication rather than merely promised, mentioned, or implied by an artifact."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2024
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.BenchmarkContribution/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer a contribution claim solely from the existence of a corresponding artifact, method, section, or recommendation."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2027
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/claimsContributionType.BenchmarkContribution/doNotCodeWhen/002",
    "@type": [
