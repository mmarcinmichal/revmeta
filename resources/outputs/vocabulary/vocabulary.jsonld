      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An included source whose evidential role is to provide methodological knowledge, guidance, recommendations, reporting/conduct guidance, or method-focused evidence about how research, reviews, evidence synthesis, appraisal, measurement, or reporting should be designed or performed, where that methodological content materially contributes to the review synthesis."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/revmeta/scheme"
