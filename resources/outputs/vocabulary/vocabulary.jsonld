  {
    "@id": "https://w3id.org/revmeta/hasReviewDesign.SystematizedReviewDesign",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A review design explicitly presented as systematized/systematised or semi-systematic: it deliberately applies substantial systematic-review elements while not claiming, or not meeting the publication’s own claim of, a full systematic review design."
      }
    ],
