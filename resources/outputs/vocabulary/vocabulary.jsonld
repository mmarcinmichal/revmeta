    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The review produces a named or otherwise discrete design artifact that can be independently identified and reused/referred to."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
