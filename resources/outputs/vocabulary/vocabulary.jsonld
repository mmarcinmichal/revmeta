  },
  {
    "@id": "https://w3id.org/revmeta/guidance/producesOutputArtifact.ConceptualModelArtifact/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "An ordinary table, figure, or discussion passage resembles a conceptual model artifact but has no discrete artifact identity."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
