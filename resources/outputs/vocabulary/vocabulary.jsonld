    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The authors identify the publication as a systematic review and report structured database/search procedures plus explicit eligibility screening/selection of the evidence set."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 121
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematizedReviewDesign/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "SystematizedReviewDesign is a declared design family, not a quality grade."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 229
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematizedReviewDesign/boundaryNote/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A single design claim should not be normalized simultaneously to SystematicReviewDesign and SystematizedReviewDesign; co-coding would require distinct independently reported design components."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 230
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematizedReviewDesign/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The publication explicitly self-identifies the design as systematized/systematised/semi-systematic review, OR explicitly states that it intentionally applies substantial systematic-review elements while presenting the design as partial/semi-systematic rather than a full systematic review."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 221
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematizedReviewDesign/codeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The declared partial/systematized design is reflected in the described review procedure."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 222
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematizedReviewDesign/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not use as a fallback label for a systematic review that is incompletely reported, methodologically weak, or judged noncompliant."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 225
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematizedReviewDesign/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer solely from use of some systematic-search/screening practices without an explicit partial/systematized design cue."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 226
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematizedReviewDesign/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A paper is missing several PRISMA items, but the authors still explicitly claim a systematic review; incompleteness alone does not make it systematized."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 236
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematizedReviewDesign/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The methods explicitly describe a semi-systematic review that applies a structured search and screening process without claiming a full systematic review."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 233
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.UmbrellaReviewDesign/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Existing reviews must be the principal evidence units; citations to prior reviews are insufficient."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 206
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.UmbrellaReviewDesign/boundaryNote/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not automatically add ExistingReview analytical object unless prior reviews are directly analyzed as objects under that property test."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 207
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.UmbrellaReviewDesign/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The publication explicitly identifies an umbrella review/overview of reviews, or the design clearly appraises and synthesizes existing reviews as the main corpus."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 199
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.UmbrellaReviewDesign/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not code merely because some reviews are cited."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 202
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.UmbrellaReviewDesign/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not add automatically to every meta-narrative review of reviews unless the umbrella role is independently supported."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 203
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.UmbrellaReviewDesign/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The publication never declares or substantively supports an umbrella review design; a superficially similar output or writing style is the only cue."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 213
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.UmbrellaReviewDesign/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The authors explicitly state that the review was conducted as an umbrella review design, and the methods are compatible with that declared design."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 210
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasSourceDocumentType.BlogPost/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A web page is not automatically a blog post; use publication form and provenance."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
