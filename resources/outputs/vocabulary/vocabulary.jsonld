  {
    "@id": "https://w3id.org/revmeta/hasAgentConfiguration.AutomatedAgent",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A stage-qualified configuration in which software or an algorithm executes a substantive review task without concurrent substantive human judgment in that execution step, although humans may configure, supervise, or review outputs before/afterward."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/revmeta/scheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "revmeta:hasAgentConfiguration.AutomatedAgent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Automated agent"
      }
    ],
    "https://w3id.org/revmeta/annotationDepth": [
      {
        "@value": "OPTIONAL_DETAIL"
      }
    ],
    "https://w3id.org/revmeta/boundaryNote": [
      {
        "@id": "https://w3id.org/revmeta/guidance/hasAgentConfiguration.AutomatedAgent/boundaryNote/001"
      },
      {
        "@id": "https://w3id.org/revmeta/guidance/hasAgentConfiguration.AutomatedAgent/boundaryNote/002"
      }
    ],
    "https://w3id.org/revmeta/codeWhen": [
      {
        "@id": "https://w3id.org/revmeta/guidance/hasAgentConfiguration.AutomatedAgent/codeWhen/001"
      }
    ],
    "https://w3id.org/revmeta/doNotCodeWhen": [
      {
        "@id": "https://w3id.org/revmeta/guidance/hasAgentConfiguration.AutomatedAgent/doNotCodeWhen/001"
      },
      {
        "@id": "https://w3id.org/revmeta/guidance/hasAgentConfiguration.AutomatedAgent/doNotCodeWhen/002"
      }
    ],
    "https://w3id.org/revmeta/negativeExample": [
      {
        "@id": "https://w3id.org/revmeta/guidance/hasAgentConfiguration.AutomatedAgent/negativeExample/001"
      }
    ],
    "https://w3id.org/revmeta/positiveExample": [
      {
        "@id": "https://w3id.org/revmeta/guidance/hasAgentConfiguration.AutomatedAgent/positiveExample/001"
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/hasAgentConfiguration.HybridHumanMachine",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A stage-qualified configuration in which human and automated/AI agents make substantively interdependent contributions within the same review task or stage, rather than merely using software as a passive tool."
      }
