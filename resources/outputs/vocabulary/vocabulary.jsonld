  {
    "@id": "https://w3id.org/revmeta/guidance/hasAnalyticalObjectType.ResearchMethod/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "ResearchMethod answers “how was research/evaluation/investigation conducted?”. Technical computational procedures answering “how does the system solve the domain task?” belong under Algorithm/ComputationalModel/Architecture as appropriate."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
