    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/boundaryNote/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "It can co-occur with PrimaryStudyReport or SecondaryStudyReport when the same included source materially bears both roles."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 542
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/boundaryNote/003",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "This development-only term closes a vocabulary gap observed in v0.2.1 source adjudication and independently replicated in the fresh v0.2.2 held-out set (RT-H05)."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 543
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Guidance documents, methodological recommendations, methodological studies, reporting/conduct guidance, or comparable method-focused sources materially contribute methodological evidence that is synthesized, compared, mapped, appraised, or interpreted."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 532
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/codeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A methodological empirical study may also be PrimaryStudyReport when it reports original research; code each material role independently."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 533
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not code domain-practice/policy guidance as methodological guidance when its role is operational or clinical/professional practice; evaluate PracticeBasedSource instead."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 536
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer from document type alone: a Guideline or Standard document is not automatically a MethodologicalGuidanceSource."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 537
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/doNotCodeWhen/003",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not code methodological guidance cited only as the current review’s own procedural authority unless it is itself part of the analyzed evidence corpus."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 538
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The authors state that they followed PRISMA or Cochrane guidance, but those documents are not analyzed as evidence."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 550
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/negativeExample/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A clinical guideline is included for its practice recommendations rather than methodological guidance; evaluate PracticeBasedSource and document type independently."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 551
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A scoping review synthesizes reporting recommendations and methodological guidance studies to compare how mapping reviews should be conducted and reported."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 546
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.MethodologicalGuidanceSource/positiveExample/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "A review analyzes methodological papers and guidance documents about automation or evidence-synthesis methods as evidence units."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 547
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PracticeBasedSource/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Organizational/government reports can qualify when they materially provide operational/practice/policy evidence. Methodological-guidance role remains a vocabulary-gap candidate."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 518
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PracticeBasedSource/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Institutional, organizational, government, professional or practitioner-origin sources contribute substantive operational/practice/policy evidence or data used in synthesis."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 511
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PracticeBasedSource/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not classify methodological guidance as practice-based solely because it gives recommendations."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 514
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PracticeBasedSource/doNotCodeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Document type or grey-literature status alone is insufficient."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 515
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PracticeBasedSource/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Practice-based source sources are mentioned in background/search eligibility but are not shown to contribute analyzable evidence to the final corpus."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 524
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PracticeBasedSource/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The included-corpus description and synthesis show that practice-based source sources materially contribute analyzable evidence."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 521
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PrimaryStudyReport/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Document type does not determine primary-study role."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 453
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PrimaryStudyReport/boundaryNote/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Code only if primary reports materially contribute analyzable evidence."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 454
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PrimaryStudyReport/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Original primary research reports materially supply evidence that is synthesized, categorized, compared, or interpreted in the main analysis. A formal included-study table is helpful but not required for narrative surveys when the role is clear from substantive analysis."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 447
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PrimaryStudyReport/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer from isolated/background primary-study citations or document format alone."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 450
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PrimaryStudyReport/negativeExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Primary study report sources are mentioned in background/search eligibility but are not shown to contribute analyzable evidence to the final corpus."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 460
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.PrimaryStudyReport/positiveExample/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "The included-corpus description and synthesis show that primary study report sources materially contribute analyzable evidence."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 457
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.SecondaryStudyReport/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer from a paper being called a review unless it is included as evidence."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 474
      }
    ]
  },
