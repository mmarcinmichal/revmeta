    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Computational/technical techniques or procedure families are direct analytical dimensions, including retrieval, ranking, prompting, fine-tuning, reasoning, search, optimization, generation, or comparable algorithmic strategies when materially synthesized."
      }
    ],
