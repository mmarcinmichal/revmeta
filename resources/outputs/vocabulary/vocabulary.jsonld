    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not infer from “state-of-the-art/SOTA” modifying methods/approaches/models; the cue must characterize the publication’s own objective/function."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
