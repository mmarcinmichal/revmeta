  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasAnalyticalObjectType.ResearchMethod/codeWhen/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Examples include study designs, statistical/analytical methods, evaluation methodologies, qualitative/quantitative research procedures, or evidence-synthesis methods when they are objects of the review rather than methods used by the current review."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 950
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasAnalyticalObjectType.ResearchMethod/doNotCodeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "Do not code domain techniques for solving the subject-matter task (e.g., prompting, retrieval, fine-tuning, ranking, reasoning, generation pipelines) merely because the source calls them methods/approaches."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
