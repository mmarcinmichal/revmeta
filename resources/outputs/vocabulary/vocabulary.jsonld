  {
    "@id": "https://w3id.org/revmeta/guidance/hasReviewDesign.SystematicReviewDesign/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "SystematicSurvey = evaluate SurveyFunction and SystematicReviewDesign separately."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
