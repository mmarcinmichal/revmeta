        "@value": 757
      }
    ]
  },
  {
    "@id": "https://w3id.org/revmeta/guidance/hasSourceDocumentType.BlogPost/codeWhen/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "At least one included analyzable source is demonstrated to be a blog post, or a mandatory restrictive criterion establishes that all included sources are of this type."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
