  {
    "@id": "https://w3id.org/revmeta/guidance/hasPublicationFunction.StateOfTheArtFunction/boundaryNote/001",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "“Current methods/frameworks” or “how X is currently assessed” can establish paper-level current-state function when this is an explicit objective and materially synthesized."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
