    "@id": "https://w3id.org/revmeta/guidance/hasEvidenceSourceRole.SecondaryStudyReport/boundaryNote/002",
    "@type": [
      "https://w3id.org/revmeta/CodingGuidanceItem"
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#value": [
      {
        "@language": "en",
        "@value": "ExistingSurvey is not automatically co-coded; apply each role definition independently."
      }
    ],
    "https://w3id.org/revmeta/itemIndex": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/revmeta/sourceLine": [
