@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix revmeta: <https://w3id.org/revmeta/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/revmeta/facet/claimsContributionType> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/claimsContributionType> revmeta:facetTier "OPTIONAL_DETAIL" .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:altLabel "claimsContributionType"@en .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:definition "Relates the review publication to types of scholarly contribution that the authors explicitly present as principal value added by the work and materially realize."@en .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.ArgumentativeContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.BenchmarkContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.ConceptualContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.DesignArtifactContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.FrameworkContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.MethodologicalContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.ResearchAgendaContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.ResourceContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:member revmeta:claimsContributionType.TaxonomyContribution .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:notation "revmeta:claimsContributionType" .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:prefLabel "claimed contribution type"@en .
<https://w3id.org/revmeta/facet/claimsContributionType> skos:scopeNote "Claims are about principal value added, not merely what the paper does or contains. Type-fit overrides labels. Publication function and output artifact remain separate."@en .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> revmeta:facetTier "OPTIONAL_DETAIL" .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:altLabel "hasAgentConfiguration"@en .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:definition "Relates specified review workflow stages to the human, automated, or integrated human-machine configuration that performs substantive work at those stages."@en .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:member revmeta:hasAgentConfiguration.AutomatedAgent .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:member revmeta:hasAgentConfiguration.HybridHumanMachine .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:member revmeta:hasAgentConfiguration.MultipleHumanReviewers .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:member revmeta:hasAgentConfiguration.SingleHumanReviewer .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:notation "revmeta:hasAgentConfiguration" .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:prefLabel "agent configuration"@en .
<https://w3id.org/revmeta/facet/hasAgentConfiguration> skos:scopeNote "The primary boundary is AutomatedAgent versus HybridHumanMachine, plus coexistence of SingleHumanReviewer and MultipleHumanReviewers within a stage when procedures differ by substage."@en .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:altLabel "hasAnalyticalObjectType"@en .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:definition "Relates the review to broad categories that themselves function as material analytical dimensions or direct targets of cross-corpus comparison, classification, mapping, appraisal, aggregation, interpretation, or synthesis. Mere evidence-carrier status, routine extraction, evaluation context, or named-instance occurrence is insufficient."@en .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Algorithm .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Architecture .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Benchmark .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.BibliographicMetadata .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.ComputationalModel .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Concept .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Dataset .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.EffectEstimate .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.ExistingReview .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.ExistingSurvey .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Finding .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Framework .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Indicator .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.InterventionOrProgramme .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.MeasurementInstrument .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Mechanism .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Practice .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Repository .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.ResearchMethod .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.ResearchTradition .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.SoftwareTool .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Standard .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Study .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Taxonomy .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:member revmeta:hasAnalyticalObjectType.Theory .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:notation "revmeta:hasAnalyticalObjectType" .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:prefLabel "analytical object type"@en .
<https://w3id.org/revmeta/facet/hasAnalyticalObjectType> skos:scopeNote "Multi-label coexistence is allowed only when each neighbor has independent material evidence. Do not co-code broader/adjacent terms merely because one concrete object can be described in several everyday-language ways."@en .
<https://w3id.org/revmeta/facet/hasCorpusComposition> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasCorpusComposition> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/hasCorpusComposition> skos:altLabel "hasCorpusComposition"@en .
<https://w3id.org/revmeta/facet/hasCorpusComposition> skos:definition "Classifies the included analyzable evidence corpus by whether it consists of scholarly/academic literature, grey/practice literature, or a substantive combination of both."@en .
<https://w3id.org/revmeta/facet/hasCorpusComposition> skos:member revmeta:hasCorpusComposition.AcademicAndGreyLiteratureCorpus .
<https://w3id.org/revmeta/facet/hasCorpusComposition> skos:member revmeta:hasCorpusComposition.AcademicLiteratureCorpus .
<https://w3id.org/revmeta/facet/hasCorpusComposition> skos:member revmeta:hasCorpusComposition.GreyLiteratureCorpus .
<https://w3id.org/revmeta/facet/hasCorpusComposition> skos:notation "revmeta:hasCorpusComposition" .
<https://w3id.org/revmeta/facet/hasCorpusComposition> skos:prefLabel "corpus composition"@en .
<https://w3id.org/revmeta/facet/hasCorpusComposition> skos:scopeNote "AcademicLiteratureCorpus, GreyLiteratureCorpus, and AcademicAndGreyLiteratureCorpus are mutually exclusive."@en .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:altLabel "hasEvidenceSourceRole"@en .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:definition "Relates the review to semantic roles played by sources that materially contribute analyzable evidence to the included corpus, including primary/secondary/survey/practice-based evidence and methodological-guidance evidence."@en .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:member revmeta:hasEvidenceSourceRole.ExistingSurvey .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:member revmeta:hasEvidenceSourceRole.MethodologicalGuidanceSource .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:member revmeta:hasEvidenceSourceRole.PracticeBasedSource .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:member revmeta:hasEvidenceSourceRole.PrimaryStudyReport .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:member revmeta:hasEvidenceSourceRole.SecondaryStudyReport .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:notation "revmeta:hasEvidenceSourceRole" .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:prefLabel "evidence source role"@en .
<https://w3id.org/revmeta/facet/hasEvidenceSourceRole> skos:scopeNote "Source roles may coexist. MethodologicalGuidanceSource is role-based, not a document type: a Guideline/Standard/JournalArticle can bear this role, and a methodological empirical study can additionally be PrimaryStudyReport if both roles are material."@en .
<https://w3id.org/revmeta/facet/hasExecutionMode> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasExecutionMode> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/hasExecutionMode> skos:altLabel "hasExecutionMode"@en .
<https://w3id.org/revmeta/facet/hasExecutionMode> skos:definition "Relates the review investigation to an explicit accelerated execution mode intended to shorten the review process through a recognized rapid-review approach."@en .
<https://w3id.org/revmeta/facet/hasExecutionMode> skos:member revmeta:hasExecutionMode.RapidExecutionMode .
<https://w3id.org/revmeta/facet/hasExecutionMode> skos:notation "revmeta:hasExecutionMode" .
<https://w3id.org/revmeta/facet/hasExecutionMode> skos:prefLabel "execution mode"@en .
<https://w3id.org/revmeta/facet/hasExecutionMode> skos:scopeNote "Rapid execution can coexist with a separately coded review design."@en .
<https://w3id.org/revmeta/facet/hasOrganizingLens> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasOrganizingLens> revmeta:facetTier "REVIEW" .
<https://w3id.org/revmeta/facet/hasOrganizingLens> skos:altLabel "hasOrganizingLens"@en .
<https://w3id.org/revmeta/facet/hasOrganizingLens> skos:definition "Relates the review to an explicit organizing perspective through which relationships among subject-matter levels or layers are synthesized."@en .
<https://w3id.org/revmeta/facet/hasOrganizingLens> skos:member revmeta:hasOrganizingLens.CrossLayerLens .
<https://w3id.org/revmeta/facet/hasOrganizingLens> skos:notation "revmeta:hasOrganizingLens" .
<https://w3id.org/revmeta/facet/hasOrganizingLens> skos:prefLabel "organizing lens"@en .
<https://w3id.org/revmeta/facet/hasOrganizingLens> skos:scopeNote "Current singleton vocabulary is domain-sensitive and showed a zero pooled Jaccard in confirmatory evaluation; extension-module treatment is preferable unless revalidated."@en .
<https://w3id.org/revmeta/facet/hasPublicationFunction> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasPublicationFunction> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:altLabel "hasPublicationFunction"@en .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:definition "Relates a review publication to a principal communicative or scholarly function that is explicitly cued and materially realized in the publication."@en .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.AgendaSettingFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.CriticalSynthesisFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.PerspectiveFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.PositionFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.ProtocolFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.StateOfTheArtFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.SurveyFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.TutorialFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:member revmeta:hasPublicationFunction.VisionFunction .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:notation "revmeta:hasPublicationFunction" .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:prefLabel "publication function"@en .
<https://w3id.org/revmeta/facet/hasPublicationFunction> skos:scopeNote "The same publication may realize several functions. Distinguish function from design, contribution claim, and output artifact."@en .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> revmeta:facetTier "OPTIONAL_DETAIL" .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> skos:altLabel "hasRegistrationStatus"@en .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> skos:definition "Classifies whether the review is explicitly registered in a formal review registry/comparable registration system or explicitly states that it was not registered."@en .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> skos:member revmeta:hasRegistrationStatus.ExplicitlyNotRegistered .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> skos:member revmeta:hasRegistrationStatus.Registered .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> skos:notation "revmeta:hasRegistrationStatus" .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> skos:prefLabel "registration status"@en .
<https://w3id.org/revmeta/facet/hasRegistrationStatus> skos:scopeNote "Registration status is optional detail; timing is a qualifier, not an additional status value."@en .
<https://w3id.org/revmeta/facet/hasReviewDesign> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasReviewDesign> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:altLabel "hasReviewDesign"@en .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:definition "Relates a review publication to the methodological review design realized by the reported review investigation, not merely to a synthesis technique, speed modifier, update mode, or publication genre label."@en .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.IntegrativeReviewDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.MetaNarrativeReviewDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.NarrativeReviewDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.QualitativeEvidenceSynthesisDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.RealistReviewDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.ScopingReviewDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.SystematicMappingDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.SystematicReviewDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.SystematizedReviewDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:member revmeta:hasReviewDesign.UmbrellaReviewDesign .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:notation "revmeta:hasReviewDesign" .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:prefLabel "review design"@en .
<https://w3id.org/revmeta/facet/hasReviewDesign> skos:scopeNote "Design values are not globally mutually exclusive. SystematicReviewDesign requires conjunction of review-level systematic framing + process realization; label alone and search alone are each insufficient."@en .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> revmeta:facetTier "OPTIONAL_DETAIL" .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:altLabel "hasSourceDocumentType"@en .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:definition "Relates the review to document or publication types demonstrably present in the included analyzable corpus."@en .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.BlogPost .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.BookOrChapter .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.ConferencePaper .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.Documentation .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.EditorialCommentary .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.Guideline .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.JournalArticle .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.Preprint .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.ProgrammeManual .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.Standard .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.TechnicalReport .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.Thesis .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:member revmeta:hasSourceDocumentType.WhitePaper .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:notation "revmeta:hasSourceDocumentType" .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:prefLabel "source document type"@en .
<https://w3id.org/revmeta/facet/hasSourceDocumentType> skos:scopeNote "Documentary forms are independent of evidence roles and corpus-composition boundedness. Do not import the stronger bounded-final-corpus threshold from hasCorpusComposition into source-document presence decisions."@en .
<https://w3id.org/revmeta/facet/hasUpdateMode> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/hasUpdateMode> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/hasUpdateMode> skos:altLabel "hasUpdateMode"@en .
<https://w3id.org/revmeta/facet/hasUpdateMode> skos:definition "Relates the review investigation to an explicit living/continuous update mode in which the evidence synthesis is intended to be updated as new evidence becomes available."@en .
<https://w3id.org/revmeta/facet/hasUpdateMode> skos:member revmeta:hasUpdateMode.LivingUpdateMode .
<https://w3id.org/revmeta/facet/hasUpdateMode> skos:notation "revmeta:hasUpdateMode" .
<https://w3id.org/revmeta/facet/hasUpdateMode> skos:prefLabel "update mode"@en .
<https://w3id.org/revmeta/facet/hasUpdateMode> skos:scopeNote "Living update mode is orthogonal to review design and publication function."@en .
<https://w3id.org/revmeta/facet/producesOutputArtifact> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/producesOutputArtifact> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:altLabel "producesOutputArtifact"@en .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:definition "Relates the review to discrete, identifiable, reusable or independently referable scholarly artifacts generated as outputs of the review synthesis."@en .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:member revmeta:producesOutputArtifact.BenchmarkArtifact .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:member revmeta:producesOutputArtifact.ConceptualModelArtifact .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:member revmeta:producesOutputArtifact.DesignArtifact .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:member revmeta:producesOutputArtifact.EvidenceMap .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:member revmeta:producesOutputArtifact.FrameworkArtifact .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:member revmeta:producesOutputArtifact.ResearchAgenda .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:member revmeta:producesOutputArtifact.ResearchResource .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:member revmeta:producesOutputArtifact.TaxonomyArtifact .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:notation "revmeta:producesOutputArtifact" .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:prefLabel "output artifact"@en .
<https://w3id.org/revmeta/facet/producesOutputArtifact> skos:scopeNote "Discreteness is functional, not file-based. Type-fit overrides labels; multi-typing requires independent structural fit for each type."@en .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> rdf:type skos:Collection .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> revmeta:facetTier "CORE_FACET" .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:altLabel "usesSynthesisMethod"@en .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:definition "Relates the review to substantive methods used to integrate, aggregate, code, map, interpret, or otherwise synthesize evidence across included sources."@en .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:member revmeta:usesSynthesisMethod.BibliometricNetworkSynthesis .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:member revmeta:usesSynthesisMethod.DescriptiveMappingSynthesis .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:member revmeta:usesSynthesisMethod.FrameworkSynthesis .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:member revmeta:usesSynthesisMethod.MetaAnalysis .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:member revmeta:usesSynthesisMethod.MetaNarrativeSynthesis .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:member revmeta:usesSynthesisMethod.MixedMethodsSynthesis .
<https://w3id.org/revmeta/facet/usesSynthesisMethod> skos:member revmeta:usesSynthesisMethod.NarrativeSynthesis .
